// hostile_tests.nv — hunk headers that name a line number as large as
// an Int allows.

use std.test
use std.list
use diffpatch

// Whether the patch left the text as it was, which is what a hunk that
// names no place in it must do.
fn left_alone(text: Str, patch: Str) -> Bool
    match diffpatch.parse_unified(patch)
        Err(_) => true
        Ok(p)  =>
            if list.len(p.files) == 0
                true
            else
                diffpatch.apply(text, p.files[0], diffpatch.apply_options()).text == text

@test
fn test_a_hunk_at_the_largest_line_number_is_rejected_not_added() [io]
    test.case("a start of 2^63 - 1")
    test.assert(left_alone("a\nb\n", "--- a\n+++ b\n@@ -9223372036854775807 +9223372036854775807 @@\n-a\n+A\n"))

    test.case("a start of 2^62")
    test.assert(left_alone("a\nb\n", "--- a\n+++ b\n@@ -4611686018427387904,1 +4611686018427387904,1 @@\n-a\n+A\n"))

@test
fn test_a_script_from_a_hunk_at_a_huge_line_does_not_grow_with_the_number() [io]
    test.case("a start of 2^40")
    match diffpatch.parse_unified("--- a\n+++ b\n@@ -1099511627776 +1099511627776 @@\n-a\n+A\n")
        Err(_) => test.assert(true)
        Ok(p)  =>
            let s = diffpatch.script_of(p.files[0])
            test.assert(list.len(s.ops) < 100)
