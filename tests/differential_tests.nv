// The text a unified diff produces when applied to `a`.
fn applied(a: Str, patch: Str) -> Str
    if patch == ""
        return a
    match diffpatch.parse_unified(patch)
        Err(_) => "<parse error>"
        Ok(p)  =>
            let files = p.files
            diffpatch.apply(a, files[0], diffpatch.strict_apply_options()).text

// The text a unified diff produces when applied backwards to `b`.
fn unapplied(b: Str, patch: Str) -> Str
    if patch == ""
        return b
    let o = DiffApplyOptions { fuzz: 0, max_offset: 0, reverse: true,
                               ignore_whitespace: false, detect_already_applied: false }
    match diffpatch.parse_unified(patch)
        Err(_) => "<parse error>"
        Ok(p)  =>
            let files = p.files
            diffpatch.apply(b, files[0], o).text

@test
fn test_the_shortest_script_has_gnu_diffs_counts() [io]
    for v in vectors()
        let input = diffunit.tokenize(v.a, v.b, DiffLines)
        let c = diffscript.counts(diffscript.diff(input, diffscript.minimal_options()))
        test.assert(c.0 == v.deleted)
        test.assert(c.1 == v.inserted)

@test
fn test_the_common_subsequence_is_at_least_as_long_as_difflibs() [io]
    for v in vectors()
        let input = diffunit.tokenize(v.a, v.b, DiffLines)
        let pairs = diffscript.common_subsequence(input.a.ids, input.b.ids,
                                                  diffscript.minimal_options())
        test.assert(list.len(pairs) >= v.difflib_matched)

@test
fn test_gnu_diffs_unified_output_parses_and_applies() [io]
    for v in vectors()
        test.assert(applied(v.a, v.gnu_unified) == v.b)

@test
fn test_every_walks_own_unified_output_applies_both_ways() [io]
    let walks = [diffscript.minimal_options(), diffscript.patience_options(),
                 diffscript.histogram_options()]
    for v in vectors()
        let input = diffunit.tokenize(v.a, v.b, DiffLines)
        for o in walks
            let s = diffscript.diff(input, o)
            let text = diffrender.unified(input, s, diffrender.unified_options_named(3, "a", "b"))
            test.assert(applied(v.a, text) == v.b)
            test.assert(unapplied(v.b, text) == v.a)
