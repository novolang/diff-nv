// differential_tests.nv — this package against GNU diffutils and
// Python's difflib, which answer the same questions independently.
//
// Written by tools/differential.py; do not edit by hand.  Each vector
// is two texts, the line counts GNU `diff --minimal` deletes and
// inserts, the number of lines difflib matches, and the unified diff
// GNU `diff -U3` writes.  See the script for what each is compared
// with.

use std.test
use std.list
use diffunit
use diffscript
use diffrender
use diffpatch

struct Vector
    a: Str
    b: Str
    deleted: Int
    inserted: Int
    difflib_matched: Int
    gnu_unified: Str

fn vectors() -> [Vector]
    [
        Vector { a: "c\n", b: "c\n",
                 deleted: 0, inserted: 0, difflib_matched: 1,
                 gnu_unified: "" },
        Vector { a: "    y\nb\n}\nreturn 0\n    x\n}\nc\n    y\nb\n    x\n    x\nd\n    y\n", b: "    y\nb\n}\nreturn 0\n    x\n}\nc\n    y\nb\n    x\nd\nd\n    y\n",
                 deleted: 1, inserted: 1, difflib_matched: 12,
                 gnu_unified: "--- a\n+++ b\n@@ -8,6 +8,6 @@\n     y\n b\n     x\n-    x\n+d\n d\n     y\n" },
        Vector { a: "c\nfn main()\n    x\n}\nb\n}\n    x\nb\n    x\nreturn 0\nfn main()\n", b: "c\nfn main()\n    x\n}\nb\n    x\nb\n    x\nreturn 0\nfn main()\n",
                 deleted: 1, inserted: 0, difflib_matched: 10,
                 gnu_unified: "--- a\n+++ b\n@@ -3,7 +3,6 @@\n     x\n }\n b\n-}\n     x\n b\n     x\n" },
        Vector { a: "c\n    y\n    y\nreturn 0\nfn main()\n", b: "c\nb\n    y\n    y\nreturn 0\nfn main()\n",
