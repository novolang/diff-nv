                 gnu_unified: "--- a\n+++ b\n@@ -1,3 +1,5 @@\n d\n-\n+return 0\n+    y\n b\n+b\n\\ No newline at end of file\n" },
        Vector { a: "return 0\n}\nfn main()\nb\nfn main()\nc\nc\nreturn 0\n}\n", b: "}\nfn main()\nb\nfn main()\nc\nc\nreturn 0\n}\n",
