                 gnu_unified: "--- a\n+++ b\n@@ -1,4 +1,5 @@\n c\n+b\n     y\n     y\n return 0\n" },
        Vector { a: "d\n\nb\n", b: "d\nreturn 0\n    y\nb\nb",
