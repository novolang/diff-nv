// diffrender.nv — an edit script as bytes: unified, side by side, or as
// a list of rows a caller paints itself.
//
// Each rendering comes in three shapes, which differ only in where the
// bytes go:
//
//   *_into(out, …) -> [u8]              appends to the caller's buffer
//   unified(…) -> Str                   allocates one string
//   *_to<W: Write[e]>(w, …) -> ?IoError  writes to the caller's sink
//
// The third is charged what the caller's `Write` implementation costs:
// `[io]` for a terminal, `[fs]` for a file, and nothing for an in-memory
// buffer.  The package itself performs no input or output.
//
// `lines` answers the diff as values: one row per displayed line, with
// its kind, its line number on each side and its byte span.  An editor
// painting a gutter reads these rather than parsing text, because a
// context line that begins with a minus sign is not a deletion.
//
// The unified headers are `diff -u`'s, as the GNU diffutils manual
// describes them ("Detailed Description of Unified Format"): the line
// count is left out when it is 1, and an empty range is written as the
// number of the line before it with a count of 0.

use std.str
use std.list
use std.bytes
use ugrapheme
use diffunit
use diffscript

// The `---` and `+++` header lines a unified diff opens a file with.
//
// Both names and both timestamps are the caller's strings, written as
// given.  An empty stamp writes the name alone, which is what `git diff`
// does.  When both names are empty the two header lines are left out
// and the diff starts at its first `@@` line.
pub struct DiffLabels
    a_name: Str
    b_name: Str
    a_stamp: Str
    b_stamp: Str

// How a unified diff is written.
pub struct DiffUnifiedOptions
    // Unchanged tokens kept on each side of a change.  `diff -U3` is 3.
    context: Int
    labels: DiffLabels
    // Write `\ No newline at end of file` after a token that
    // `diffunit.token_unterminated` reports.  On by default, because a
    // patch that omits it adds a newline when it is applied.
    no_newline_marker: Bool
    // The section heading written after each hunk's second `@@`, one per
    // hunk in order: the function a hunk is inside, which `diff -p`
    // finds by reading the language.  A hunk past the end of the list
    // gets none, so an empty list writes none at all.
    sections: [Str]

// A displayed line, for a caller that paints its own.
pub enum DiffLineKind
    // Present on both sides.
    DiffLineContext
    // Present on the left only.  A `-` line.
    DiffLineRemoved
    // Present on the right only.  A `+` line.
    DiffLineAdded
    // The `\ No newline at end of file` marker.
    DiffLineMarker

// One row of a rendered diff.
pub struct DiffRenderLine
    kind: DiffLineKind
    // The 1-based line number on the left, or 0 where there is none.
    a_line: Int
    // The 1-based line number on the right, or 0 where there is none.
    b_line: Int
    // Where the text is.  Read it out of `input.a` for a context,
    // removed or marker row and out of `input.b` for an added row.  A
    // marker row's span is empty, at the end of the line it qualifies.
    span: diffunit.DiffSpan
    // Which hunk the row belongs to, indexing `diffscript.hunks`.
    hunk: Int

// How a side-by-side diff is laid out.
pub struct DiffColumnOptions
    context: Int
    // Terminal columns for each of the two text columns, not counting
    // the gutter.
    width: Int
    // Written between the two columns.  Its `|` is replaced by a space
    // for an unchanged row, by `<` for a deletion and by `>` for an
    // insertion, as `diff -y` does.
    gutter: Str
    // Display width of one grapheme cluster, supplied by the caller.
    // unicode-nv's `uwidth.cluster_width` is the one a terminal wants.
    cluster_width: fn(Str) -> Int
    // Wrap a line too wide for its column onto the next row, rather
    // than cutting it and ending it with `…`.
    wrap: Bool

// `diff -U<context>` with no file names.
//
// ```novo
// use diffrender
//
// println(str.from_int(diffrender.unified_options(3).context))   // 3
// ```
pub fn unified_options(context: Int) -> DiffUnifiedOptions []
    unified_options_named(context, "", "")

// `diff -U<context>` with the two names and no timestamps, which is what
// `git diff` writes.
//
// ```novo
// use diffrender
//
// println(diffrender.unified_options_named(3, "a/x", "b/x").labels.b_name)   // b/x
// ```
pub fn unified_options_named(context: Int, a_name: Str, b_name: Str) -> DiffUnifiedOptions []
    DiffUnifiedOptions { context: context,
                         labels: DiffLabels { a_name: a_name, b_name: b_name,
                                              a_stamp: "", b_stamp: "" },
                         no_newline_marker: true, sections: [] }

// Append a whole unified diff to `out` and answer it.  Nothing is
// appended when the script has no change.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// let input = diffunit.tokenize("a\nb\n", "a\nc\n", DiffLines)
// let s = diffscript.diff(input, diffscript.default_options())
// let o = diffrender.unified_options_named(3, "old.txt", "new.txt")
// var buf: [u8] = []
// diffrender.unified_into(buf, input, s, o)
// println(str.from_int(list.len(buf)))
// ```
pub fn unified_into(var out: [u8], input: diffunit.DiffInput, s: diffscript.DiffScript,
                    o: DiffUnifiedOptions) -> [u8] []
    let hs = diffscript.hunks(s, o.context)
    if list.len(hs) == 0
        return out
    if o.labels.a_name != "" or o.labels.b_name != ""
        put(out, "--- " + labelled(o.labels.a_name, o.labels.a_stamp) + "\n")
        put(out, "+++ " + labelled(o.labels.b_name, o.labels.b_stamp) + "\n")
    for i in 0..list.len(hs)
        let section = if i < list.len(o.sections)
            o.sections[i]
        else
            ""
        hunk_header_into(out, hs[i], section)
        for op in hs[i].ops
            match op
                DiffEqual(a, _)   => emit(out, " ", input.a, a, o.no_newline_marker)
                DiffDelete(a, _)  => emit(out, "-", input.a, a, o.no_newline_marker)
                DiffInsert(_, b)  => emit(out, "+", input.b, b, o.no_newline_marker)
                DiffReplace(a, b) =>
                    emit(out, "-", input.a, a, o.no_newline_marker)
                    emit(out, "+", input.b, b, o.no_newline_marker)
    out

// The same diff as a new `Str`.  `unified_into` is the call for a caller
// that already has a buffer.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// let input = diffunit.tokenize("a\n", "b\n", DiffLines)
// let s = diffscript.diff(input, diffscript.default_options())
// print(diffrender.unified(input, s, diffrender.unified_options(3)))
// ```
pub fn unified(input: diffunit.DiffInput, s: diffscript.DiffScript, o: DiffUnifiedOptions) -> Str []
    var buf: [u8] = []
    unified_into(buf, input, s, o)
    bytes.byte_list_to_str(buf)

// Write a unified diff to the caller's sink, charged what the sink
// costs.
//
// The answer is `None` when every byte went out, and the sink's error
// otherwise.  Nothing else can fail: a script and its input are already
// consistent.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// fn write_diff(w: File, a: Str, b: Str) -> ?IoError [io, fs]
//     let input = diffunit.tokenize(a, b, DiffLines)
//     let s = diffscript.diff(input, diffscript.default_options())
//     diffrender.unified_to(w, input, s, diffrender.unified_options(3))
// ```
pub fn unified_to<W: Write[e]>(w: W, input: diffunit.DiffInput, s: diffscript.DiffScript,
                               o: DiffUnifiedOptions) -> ?IoError [e]
    var buf: [u8] = []
    unified_into(buf, input, s, o)
    w.write_all(bytes.from_byte_list(buf))

// Append one `@@ -l,s +l,s @@` header to `out`, with `section` after the
// second `@@` when it is not empty.
//
// The count is left out when it is 1, and an empty range is written as
// the line before it with a count of 0.  A hand-written header that gets
// either wrong does not apply.
//
// ```novo
// use diffscript
// use diffrender
//
// let s = diffscript.diff_ids([1, 2, 3], [1, 9, 3], diffscript.minimal_options())
// var buf: [u8] = []
// diffrender.hunk_header_into(buf, diffscript.hunks(s, 1)[0], "")
// print(bytes.byte_list_to_str(buf))   // @@ -1,3 +1,3 @@
// ```
pub fn hunk_header_into(var out: [u8], h: diffscript.DiffHunk, section: Str) -> [u8] []
    var line = "@@ -" + range_text(h.a) + " +" + range_text(h.b) + " @@"
    if section != ""
        line = line + " " + section
    put(out, line + "\n")
    out

// The diff as rows a caller paints itself, hunk by hunk, with `context`
// unchanged lines around each change.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// let input = diffunit.tokenize("a\nb\n", "a\nc\n", DiffLines)
// let s = diffscript.diff(input, diffscript.default_options())
// for row in diffrender.lines(input, s, 3)
//     match row.kind
//         DiffLineRemoved => println("-")
//         DiffLineAdded   => println("+")
//         _               => println(" ")
// ```
pub fn lines(input: diffunit.DiffInput, s: diffscript.DiffScript,
             context: Int) -> [DiffRenderLine] []
    var rows: [DiffRenderLine] = []
    let hs = diffscript.hunks(s, context)
    for hi in 0..list.len(hs)
        for op in hs[hi].ops
            match op
                DiffEqual(a, b)   =>
                    for k in 0..diffunit.range_len(a)
                        push_row(rows, input.a, DiffLineContext, a.start + k, b.start + k, hi)
                DiffDelete(a, _)  => push_rows(rows, input.a, DiffLineRemoved, a, hi)
                DiffInsert(_, b)  => push_rows(rows, input.b, DiffLineAdded, b, hi)
                DiffReplace(a, b) =>
                    push_rows(rows, input.a, DiffLineRemoved, a, hi)
                    push_rows(rows, input.b, DiffLineAdded, b, hi)
    rows

// Side-by-side layout, `diff -y`'s: three lines of context, a ` | `
// gutter and no wrapping.
//
// ```novo
// use diffrender
//
// fn one(cluster: Str) -> Int
//     1
//
// println(str.from_int(diffrender.column_options(40, one).width))   // 40
// ```
pub fn column_options(width: Int, cluster_width: fn(Str) -> Int) -> DiffColumnOptions []
    DiffColumnOptions { context: 3, width: width, gutter: " | ",
                        cluster_width: cluster_width, wrap: false }

// Append a side-by-side diff to `out`: each hunk opens with its `@@`
// header, then one row per pair of lines, the left column padded to
// `width` cells as the caller's width function measures them.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// fn one(cluster: Str) -> Int
//     1
//
// let input = diffunit.tokenize("a\n", "b\n", DiffLines)
// let s = diffscript.diff(input, diffscript.default_options())
// var buf: [u8] = []
// diffrender.side_by_side_into(buf, input, s, diffrender.column_options(10, one))
// print(bytes.byte_list_to_str(buf))
// ```
pub fn side_by_side_into(var out: [u8], input: diffunit.DiffInput, s: diffscript.DiffScript,
                         o: DiffColumnOptions) -> [u8] []
    for h in diffscript.hunks(s, o.context)
        hunk_header_into(out, h, "")
        for op in h.ops
            match op
                DiffEqual(a, b)   => pair_rows(out, input, a, b, " ", o)
                DiffDelete(a, b)  => pair_rows(out, input, a, b, "<", o)
                DiffInsert(a, b)  => pair_rows(out, input, a, b, ">", o)
                DiffReplace(a, b) => pair_rows(out, input, a, b, "|", o)
    out

// Write a side-by-side diff to the caller's sink, charged what the sink
// costs.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// fn one(cluster: Str) -> Int
//     1
//
// fn show(w: File, a: Str, b: Str) -> ?IoError [io, fs]
//     let input = diffunit.tokenize(a, b, DiffLines)
//     let s = diffscript.diff(input, diffscript.default_options())
//     diffrender.side_by_side_to(w, input, s, diffrender.column_options(40, one))
// ```
pub fn side_by_side_to<W: Write[e]>(w: W, input: diffunit.DiffInput, s: diffscript.DiffScript,
                                    o: DiffColumnOptions) -> ?IoError [e]
    var buf: [u8] = []
    side_by_side_into(buf, input, s, o)
    w.write_all(bytes.from_byte_list(buf))

// Append git's `--stat` lines for one file: the name, the change count
// and a bar of `+` and `-`, then the summary line in git's wording, such
// as ` 1 file changed, 2 insertions(+), 1 deletion(-)`.  The bar is
// scaled to at most 60 characters.
//
// ```novo
// use diffrender
//
// var buf: [u8] = []
// diffrender.stat_line_into(buf, "a.txt", 1, 2)
// print(bytes.byte_list_to_str(buf))
// ```
pub fn stat_line_into(var out: [u8], name: Str, deleted: Int, inserted: Int) -> [u8] []
    let total = deleted + inserted
    var plus = inserted
    var minus = deleted
    if total > 60
        plus = at_least_one(inserted * 60 / total, inserted)
        minus = at_least_one(deleted * 60 / total, deleted)
    put(out, " " + name + " | " + str.from_int(total) + " " + str.repeat("+", plus)
             + str.repeat("-", minus) + "\n")
    var summary = " 1 file changed"
    if inserted > 0
        summary = summary + ", " + counted(inserted, "insertion") + "(+)"
    if deleted > 0
        summary = summary + ", " + counted(deleted, "deletion") + "(-)"
    put(out, summary + "\n")
    out

// Word-level marks inside one changed operation: the byte spans of the
// left input that were removed, and of the right input that were added,
// read from `refined`, the script `diffscript.refine` answered for `at`
// at granularity `finer`.
//
// The spans are offsets into `input.a.text` and `input.b.text`, so a
// terminal can invert them, an HTML renderer can wrap them and a plain
// renderer can ignore them.
//
// ```novo
// use diffunit
// use diffscript
// use diffrender
//
// let input = diffunit.tokenize("a b\n", "a c\n", DiffLines)
// let s = diffscript.diff(input, diffscript.minimal_options())
// let r = diffscript.refine(input, s.ops[0], DiffWords, diffscript.minimal_options())
// let marks = diffrender.inline_marks(input, r, s.ops[0], DiffWords)
// println(str.from_int(marks.0[0].start))   // 2
// ```
pub fn inline_marks(input: diffunit.DiffInput, refined: diffscript.DiffScript,
                    at: diffscript.DiffOp,
                    finer: diffunit.DiffUnit) -> ([diffunit.DiffSpan], [diffunit.DiffSpan]) []
    let sub = diffscript.refined_input(input, at, finer)
    let base_a = diffunit.range_span(input.a, diffscript.op_a(at)).start
    let base_b = diffunit.range_span(input.b, diffscript.op_b(at)).start
    var left: [diffunit.DiffSpan] = []
    var right: [diffunit.DiffSpan] = []
    for op in refined.ops
        if not diffscript.op_changed(op)
            continue
        let ra = diffscript.op_a(op)
        if not diffunit.range_empty(ra)
            let sp = diffunit.range_span(sub.a, ra)
            list.push(left, DiffSpan { start: base_a + sp.start, end: base_a + sp.end })
        let rb = diffscript.op_b(op)
        if not diffunit.range_empty(rb)
            let sp = diffunit.range_span(sub.b, rb)
            list.push(right, DiffSpan { start: base_b + sp.start, end: base_b + sp.end })
    (left, right)

// ── Helpers ───────────────────────────────────────────────────────────

// Append the bytes of `s` to `out`.
fn put(var out: [u8], s: Str)
    list.append(out, bytes.to_byte_list(bytes.from_str(s)))

fn labelled(name: Str, stamp: Str) -> Str
    if stamp == ""
        name
    else
        name + "\t" + stamp

fn range_text(r: diffunit.DiffRange) -> Str
    let n = diffunit.range_len(r)
    if n == 1
        str.from_int(r.start + 1)
    elif n == 0
        str.from_int(r.start) + ",0"
    else
        str.from_int(r.start + 1) + "," + str.from_int(n)

// Append every token of `r` as one line, each prefixed by `mark`.  A
// token with no newline of its own gets one, followed by the marker line
// when the token is the unterminated last line of its input.
fn emit(var out: [u8], mark: Str, t: diffunit.DiffTokens, r: diffunit.DiffRange, marker: Bool)
    for i in r.start..r.end
        let text = diffunit.token_str(t, i)
        put(out, mark + text)
        if not str.ends_with(text, "\n")
            put(out, "\n")
            if marker and diffunit.token_unterminated(t, i)
                put(out, "\\ No newline at end of file\n")

fn push_row(var rows: [DiffRenderLine], t: diffunit.DiffTokens, kind: DiffLineKind, a_index: Int,
            b_index: Int, hunk: Int)
    let a_line = if a_index >= 0
        a_index + 1
    else
        0
    let b_line = if b_index >= 0
        b_index + 1
    else
        0
    let i = if a_index >= 0
        a_index
    else
        b_index
    let sp = diffunit.token_span(t, i)
    list.push(rows, DiffRenderLine { kind: kind, a_line: a_line, b_line: b_line,
                                     span: sp, hunk: hunk })
    if diffunit.token_unterminated(t, i)
        list.push(rows, DiffRenderLine { kind: DiffLineMarker, a_line: 0, b_line: 0,
                                         span: DiffSpan { start: sp.end, end: sp.end },
                                         hunk: hunk })

fn push_rows(var rows: [DiffRenderLine], t: diffunit.DiffTokens, kind: DiffLineKind,
             r: diffunit.DiffRange, hunk: Int)
    for i in r.start..r.end
        if kind == DiffLineAdded
            push_row(rows, t, kind, -1, i, hunk)
        else
            push_row(rows, t, kind, i, -1, hunk)

fn at_least_one(scaled: Int, raw: Int) -> Int
    if raw > 0 and scaled == 0
        1
    else
        scaled

fn counted(n: Int, noun: Str) -> Str
    str.from_int(n) + " " + noun + (if n == 1 then "" else "s")

// A token's text with its line terminator taken off, for a column.
fn column_text(t: diffunit.DiffTokens, i: Int) -> Str
    var text = diffunit.token_str(t, i)
    if str.ends_with(text, "\n")
        text = str.slice(text, 0, str.len(text) - 1)
    if str.ends_with(text, "\r")
        text = str.slice(text, 0, str.len(text) - 1)
    text

// The rows of one operation: the i-th line of each side on row i, with
// `mark` in the gutter, and `<` or `>` where only one side has a line.
fn pair_rows(var out: [u8], input: diffunit.DiffInput, a: diffunit.DiffRange, b: diffunit.DiffRange,
             mark: Str, o: DiffColumnOptions)
    let la = diffunit.range_len(a)
    let lb = diffunit.range_len(b)
    let n = if la > lb
        la
    else
        lb
    for k in 0..n
        let left = if k < la
            column_text(input.a, a.start + k)
        else
            ""
        let right = if k < lb
            column_text(input.b, b.start + k)
        else
            ""
        var m = mark
        if k >= la
            m = ">"
        elif k >= lb
            m = "<"
        side_row(out, left, right, m, o)

// One logical row, cut or wrapped to the column width.
fn side_row(var out: [u8], left: Str, right: Str, mark: Str, o: DiffColumnOptions)
    let lp = pieces(left, o)
    let rp = pieces(right, o)
    let n = if list.len(lp) > list.len(rp)
        list.len(lp)
    else
        list.len(rp)
    let gutter = if str.contains(o.gutter, "|")
        str.replace(o.gutter, "|", mark)
    else
        o.gutter
    let blank = str.replace(gutter, mark, " ")
    for k in 0..n
        let l = if k < list.len(lp)
            lp[k]
        else
            ("", 0)
        let r = if k < list.len(rp)
            rp[k].0
        else
            ""
        let g = if k == 0
            gutter
        else
            blank
        let row = l.0 + str.repeat(" ", o.width - l.1) + g + r
        put(out, str.trim_end(row) + "\n")

// A column's text as the pieces it occupies, each with its width in
// cells: one piece cut with `…` when the text is too wide, or several
// when the options wrap.
fn pieces(text: Str, o: DiffColumnOptions) -> [(Str, Int)]
    var out: [(Str, Int)] = []
    var start = 0
    var cells = 0
    let cw = o.cluster_width
    let clusters = ugrapheme.clusters(text)
    for ci in 0..list.len(clusters)
        let c = clusters[ci]
        let w = cw(str.slice(text, c.start, c.end))
        if cells + w > o.width
            if not o.wrap
                // Nothing has been cut yet, so the piece starts at 0.
                let ell = cw("…")
                let room = o.width - ell
                var end = start
                var used = 0
                for c2 in clusters
                    let w2 = cw(str.slice(text, c2.start, c2.end))
                    if used + w2 > room
                        break
                    used = used + w2
                    end = c2.end
                list.push(out, (str.slice(text, start, end) + "…", used + ell))
                return out
            list.push(out, (str.slice(text, start, c.start), cells))
            start = c.start
            cells = 0
        cells = cells + w
    list.push(out, (str.slice(text, start, str.len(text)), cells))
    out
